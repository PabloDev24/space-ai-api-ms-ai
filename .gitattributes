# Normalize line endings to LF in the repo; checkout as-is on all platforms
* text=auto eol=lf

# Python files always LF
*.py text eol=lf

# Shell scripts always LF (would break on Windows CRLF)
*.sh text eol=lf

# Docker/config files always LF
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf
requirements*.txt text eol=lf

# JSON/Markdown
*.json text eol=lf
*.md text eol=lf

# Binaries — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
