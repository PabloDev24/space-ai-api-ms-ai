# ── Proveedor de LLM ─────────────────────────────────────────────────────────
# Opciones: gemini | groq | openai
PROVEEDOR=groq

# ── API Keys (solo la del proveedor activo es requerida) ──────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Modelo (opcional, cada proveedor tiene un default) ────────────────────────
# Groq:   llama-3.3-70b-versatile | mixtral-8x7b-32768 | llama-3.1-8b-instant
# Gemini: gemini-2.5-flash | gemini-1.5-pro
# OpenAI: gpt-4o-mini | gpt-4o
# MODELO=llama-3.3-70b-versatile

# ── Embeddings ───────────────────────────────────────────────────────────────
# Proveedor: local | openai | gemini
# local  → fastembed ONNX, gratis, sin API key (recomendado para empezar)
# openai → text-embedding-3-small (requiere OPENAI_API_KEY)
# gemini → text-embedding-004 (requiere GEMINI_API_KEY)
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # opcional, sobreescribe el default

# ── RAG ───────────────────────────────────────────────────────────────────────
CHROMA_PATH=chroma_db
COLLECTION_NAME=documentos
N_RESULTADOS=8
